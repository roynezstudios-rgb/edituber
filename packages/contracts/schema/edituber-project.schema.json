{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edituber.dev/schemas/edituber-project-v2.json",
  "title": "EDITuber Project v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "title",
    "fps",
    "width",
    "height",
    "durationInFrames",
    "seed",
    "audio",
    "stage",
    "avatar",
    "stateEvents",
    "settings"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "projectId": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "fps": { "type": "integer", "minimum": 12, "maximum": 120 },
    "width": { "type": "integer", "minimum": 64, "maximum": 7680 },
    "height": { "type": "integer", "minimum": 64, "maximum": 7680 },
    "durationInFrames": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "durationSeconds", "envelope"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "envelope": { "type": "string", "minLength": 1 }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backgroundType", "backgroundColor"],
      "properties": {
        "backgroundType": { "enum": ["solid", "transparent", "image"] },
        "backgroundColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "backgroundImage": { "type": "string", "minLength": 1 }
      },
      "if": {
        "properties": { "backgroundType": { "const": "image" } },
        "required": ["backgroundType"]
      },
      "then": { "properties": { "backgroundImage": true }, "required": ["backgroundImage"] }
    },
    "avatar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "defaultStateId", "positionX", "positionY", "scale"],
      "properties": {
        "manifest": { "type": "string", "minLength": 1 },
        "defaultStateId": { "type": "string", "format": "uuid" },
        "positionX": { "type": "number", "minimum": 0, "maximum": 1 },
        "positionY": { "type": "number", "minimum": 0, "maximum": 1 },
        "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 }
      }
    },
    "stateEvents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frame", "stateId"],
        "properties": {
          "frame": { "type": "integer", "minimum": 0 },
          "stateId": { "type": "string", "format": "uuid" }
        }
      }
    },
    "effects": {
      "$ref": "https://edituber.dev/schemas/avatar-manifest-v2.json#/$defs/effects"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blinkEnabled",
        "talkBounceEnabled",
        "mouthSensitivity",
        "transitionFrames",
        "bouncePreset"
      ],
      "properties": {
        "blinkEnabled": { "type": "boolean" },
        "talkBounceEnabled": { "type": "boolean" },
        "mouthSensitivity": { "type": "number", "minimum": 0, "maximum": 1 },
        "transitionFrames": { "type": "integer", "minimum": 0, "maximum": 60 },
        "bouncePreset": { "enum": ["soft", "normal", "emphasis"] },
        "motionScale": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    }
  }
}
